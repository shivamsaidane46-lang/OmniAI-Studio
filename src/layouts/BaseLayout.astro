---
const { title, description, canonical = 'https://omniaistudio.in/', noindex = false } = Astro.props;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'OmniAI Studio',
  url: 'https://omniaistudio.in/',
  logo: 'https://omniaistudio.in/omniai-logo.svg',
  description: 'AI automation and intelligent systems studio building AI-powered workflows, document-processing systems, AI agents, integrations, and custom business tools.',
  knowsAbout: ['AI automation', 'business process automation', 'document intelligence', 'AI agents', 'workflow orchestration', 'API integrations', 'custom AI systems']
};
const website = {'@context':'https://schema.org','@type':'WebSite',name:'OmniAI Studio',url:'https://omniaistudio.in/'};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07090f" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/omniai-icon.svg" />
    <link rel="apple-touch-icon" href="/omniai-icon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="OmniAI Studio" />
    <meta property="og:image" content="https://omniaistudio.in/omniai-logo.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://omniaistudio.in/omniai-logo.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="OmniAI Studio home"><img src="/omniai-logo.svg" alt="OmniAI Studio" /></a>
      <nav aria-label="Primary navigation"><a href="/work">Work</a><a href="/case-studies">Case Studies</a><a href="/services">Services</a><a href="/about">About</a><a href="/contact">Contact</a></nav>
      <a class="header-cta" href="/contact">Start a project <span>↗</span></a>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><div><a class="brand footer-brand" href="/" aria-label="OmniAI Studio home"><img src="/omniai-logo.svg" alt="OmniAI Studio" /></a><p>AI automation & intelligent systems.</p></div><div class="footer-links"><a href="/work">Work</a><a href="/case-studies">Case Studies</a><a href="/services">Services</a><a href="/about">About</a><a href="/contact">Contact</a></div><p class="copyright">© {new Date().getFullYear()} OmniAI Studio</p></footer>
  </body>
</html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color-scheme:dark;background:#07090f;color:#f3f5f8;font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#07090f;color:#f3f5f8;min-width:320px}body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at 70% 10%,rgba(92,112,255,.10),transparent 30%),radial-gradient(circle at 15% 25%,rgba(74,210,232,.06),transparent 25%)}a{color:inherit}.skip-link{position:fixed;left:12px;top:-100px;z-index:100;background:#f3f5f8;color:#07090f;padding:10px 14px;border-radius:8px}.skip-link:focus{top:12px}.site-header{position:sticky;top:0;z-index:20;max-width:1240px;margin:auto;padding:16px 24px;display:flex;align-items:center;gap:28px;background:rgba(7,9,15,.82);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.06)}.brand{display:inline-flex;align-items:center;text-decoration:none;line-height:0}.brand img{display:block;width:156px;height:auto;max-height:48px}.site-header nav{display:flex;gap:22px;margin-left:auto}.site-header nav a,.footer-links a{font-size:13px;color:#8f98aa;text-decoration:none}.site-header nav a:hover,.footer-links a:hover{color:#fff}.header-cta{font-size:13px;text-decoration:none;border:1px solid #2b3342;padding:10px 14px;border-radius:9px}.header-cta:hover{border-color:#58657b;background:#0c1018}.header-cta span{color:#8de4f4;margin-left:5px}.site-footer{max-width:1240px;margin:80px auto 0;padding:32px 24px 44px;border-top:1px solid #202634;display:grid;grid-template-columns:1fr auto auto;gap:30px;align-items:end}.site-footer p{color:#697387;font-size:13px;margin:8px 0 0}.footer-brand img{width:142px;max-height:42px}.footer-links{display:flex;gap:20px;flex-wrap:wrap}.copyright{text-align:right}.page{max-width:1240px;margin:auto;padding:90px 24px}.eyebrow{font-size:11px;letter-spacing:.18em;font-weight:800;color:#8de4f4}.display{font-size:clamp(48px,8vw,92px);line-height:.94;letter-spacing:-.065em;max-width:980px;margin:22px 0}.muted{color:#8f98aa}.lead{font-size:19px;line-height:1.7;max-width:730px;color:#aeb6c5}.section{margin-top:110px}.section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:28px}.section-head h2{font-size:34px;letter-spacing:-.04em;margin:0}.section-head p{max-width:520px;color:#737e92;line-height:1.6}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.card{border:1px solid #202634;background:linear-gradient(145deg,#0d111b,#090c13);border-radius:16px;padding:28px;text-decoration:none;transition:transform .2s,border-color .2s}.card:hover{transform:translateY(-3px);border-color:#384356}.tag{display:inline-flex;padding:6px 9px;border:1px solid #283141;border-radius:999px;color:#8f98aa;font-size:11px}.card h3{font-size:24px;letter-spacing:-.03em;margin:38px 0 10px}.card p{color:#818b9e;line-height:1.6;margin:0}.button{display:inline-flex;padding:13px 17px;border-radius:9px;text-decoration:none;font-weight:700;font-size:13px;border:0;cursor:pointer}.button.primary{background:#f3f5f8;color:#07090f}.button.secondary{border:1px solid #303849;color:#f3f5f8;background:transparent}.kicker-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#202634;border:1px solid #202634;border-radius:16px;overflow:hidden}.kicker-grid>div{background:#0b0e15;padding:25px}.kicker-grid strong{display:block;font-size:18px;margin-bottom:8px}.kicker-grid span{font-size:13px;line-height:1.5;color:#747f93}@media(max-width:850px){.site-header{flex-wrap:wrap}.site-header nav{order:3;width:100%;overflow:auto;margin:0}.header-cta{margin-left:auto}.grid{grid-template-columns:1fr}.kicker-grid{grid-template-columns:1fr 1fr}.site-footer{grid-template-columns:1fr}.copyright{text-align:left}}@media(max-width:520px){.page{padding-top:60px}.kicker-grid{grid-template-columns:1fr}.display{font-size:52px}.site-header{padding:14px 16px}.brand img{width:138px}.header-cta{display:none}}
</style>
