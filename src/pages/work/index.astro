---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).filter((project) => project.data.status === 'published');
---
<BaseLayout title="Work — OmniAI Studio" description="Explore AI automation, document intelligence, workflow, and intelligent-system projects built by OmniAI Studio." canonical="https://omniaistudio.in/work">
<div class="page"><p class="eyebrow">WORK</p><h1 class="display">Systems built to solve specific problems.</h1><p class="lead">A growing library of AI workflows, automation experiments, document-processing systems, and custom tools. Each project is documented with enough detail to understand what was built and why.</p><section class="section"><div class="grid">{projects.map((project) => <a class="card" href={`/work/${project.id}`}><span class="tag">{project.data.category}</span><h3>{project.data.title}</h3><p>{project.data.description}</p></a>)}<div class="card"><span class="tag">Growing portfolio</span><h3>More systems coming</h3><p>New projects will appear here automatically when they are published through the owner CMS.</p></div></div></section></div>
</BaseLayout>
