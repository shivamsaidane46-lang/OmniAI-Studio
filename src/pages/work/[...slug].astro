---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((project) => project.data.status === 'published');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, category, technologies, demoVideo, liveDemo, github } = project.data;
---
<BaseLayout title={`${title} — OmniAI Studio`} description={description} canonical={`https://omniaistudio.in/work/${project.id}`}>
<div class="page"><p class="eyebrow">PROJECT · {category.toUpperCase()}</p><h1 class="display">{title}</h1><p class="lead">{description}</p><div class="actions"><a class="button primary" href="/contact">Discuss a similar system ↗</a><a class="button secondary" href="/work">Back to work</a></div><section class="section"><div class="card project-content"><Content /></div></section>{technologies.length > 0 && <section class="section"><div class="section-head"><h2>Technologies</h2><p>The tools and technical areas associated with this project.</p></div><div class="kicker-grid">{technologies.map((tech) => <div><strong>{tech}</strong><span>Used as part of the project architecture.</span></div>)}</div></section>}{(demoVideo || liveDemo || github) && <section class="section"><div class="section-head"><h2>Resources</h2><p>Project resources will be added as they become available.</p></div><div class="actions">{demoVideo && <a class="button secondary" href={demoVideo} rel="noopener noreferrer">Watch demo ↗</a>}{liveDemo && <a class="button secondary" href={liveDemo} rel="noopener noreferrer">Open live demo ↗</a>}{github && <a class="button secondary" href={github} rel="noopener noreferrer">View source ↗</a>}</div></section>}</div>
</BaseLayout>
<style is:global>.project-content{line-height:1.75;color:#aeb6c5}.project-content h2{color:#f3f5f8;font-size:30px;letter-spacing:-.04em;margin-top:0}.project-content h3{color:#f3f5f8}.project-content a{color:#8de4f4}.project-content li{margin:8px 0}</style>
