---
import BaseLayout from '../../layouts/BaseLayout.astro';

const serviceData = [
  {
    slug: 'ai-automation',
    title: 'AI Automation',
    eyebrow: 'SERVICE · AI AUTOMATION',
    description: 'Design and build workflows that connect business processes, APIs, data, and AI into reliable automation.',
    points: ['Lead intake and qualification', 'Data enrichment and routing', 'Email and notification workflows', 'CRM and spreadsheet automation', 'API orchestration and webhooks']
  },
  {
    slug: 'document-ai',
    title: 'Document AI',
    eyebrow: 'SERVICE · DOCUMENT INTELLIGENCE',
    description: 'Turn invoices, forms, PDFs, and other variable documents into structured, validated information.',
    points: ['Invoice and receipt extraction', 'Form and PDF processing', 'Field and line-item extraction', 'Schema validation and confidence checks', 'Human review for uncertain documents']
  },
  {
    slug: 'ai-agents',
    title: 'AI Agents',
    eyebrow: 'SERVICE · AI AGENTS',
    description: 'Build task-focused AI systems that can retrieve information, reason over context, and execute defined actions.',
    points: ['Knowledge retrieval', 'Task planning and tool use', 'Customer or internal assistants', 'Approval and human-in-the-loop flows', 'Guardrails and action validation']
  },
  {
    slug: 'custom-ai-systems',
    title: 'Custom AI Systems',
    eyebrow: 'SERVICE · CUSTOM SYSTEMS',
    description: 'Create focused AI-powered internal tools, assistants, dashboards, and integrations around a specific operational requirement.',
    points: ['Internal AI tools', 'Custom dashboards', 'AI-powered data workflows', 'System integrations', 'Prototype-to-production architecture']
  }
];

export function getStaticPaths() {
  return serviceData.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
---
<BaseLayout title={`${service.title} — OmniAI Studio`} description={service.description} canonical={`https://omniaistudio.in/services/${Astro.params.slug}`}>
<div class="page">
  <p class="eyebrow">{service.eyebrow}</p>
  <h1 class="display">{service.title}</h1>
  <p class="lead">{service.description}</p>
  <div class="actions"><a class="button primary" href="/contact">Discuss this service ↗</a><a class="button secondary" href="/services">All services</a></div>
  <section class="section">
    <div class="section-head"><h2>What we can build</h2><p>Scope depends on the process, existing systems, data, and reliability requirements.</p></div>
    <div class="kicker-grid">
      {service.points.map((point, index) => <div><span class="num">0{index + 1}</span><strong>{point}</strong><span>Designed as part of a larger system rather than a standalone AI feature.</span></div>)}
    </div>
  </section>
  <section class="section">
    <div class="card"><p class="eyebrow">NEXT STEP</p><h2>Start with the process you want to improve.</h2><p class="muted">A useful first conversation is usually about the current workflow, what is repetitive or slow, what systems are involved, and what a successful outcome would look like.</p><a class="button primary" href="/contact">Contact OmniAI Studio ↗</a></div>
  </section>
</div>
</BaseLayout>
<style>.num{display:block;color:#8de4f4;font-size:10px;margin-bottom:28px}.kicker-grid strong{margin-bottom:8px}.card h2{font-size:clamp(34px,5vw,56px);letter-spacing:-.05em;margin:18px 0}.card .muted{max-width:700px;line-height:1.7;margin-bottom:28px}</style>
