---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'OmniAI Studio — AI Automation & Intelligent Systems';
const description = 'OmniAI Studio builds AI-powered automations, intelligent workflows, document processing systems, AI agents, integrations, and custom business tools.';
---
<BaseLayout title={title} description={description} canonical="https://omniaistudio.in/">
  <div class="page home">
    <section class="hero-grid">
      <div>
        <p class="eyebrow">AI AUTOMATION · AGENTS · DOCUMENT INTELLIGENCE</p>
        <h1 class="display">We build intelligent systems for work that should not be manual.</h1>
        <p class="lead">OmniAI Studio designs and builds AI-powered workflows, automations, agents, document-processing systems, integrations, and custom tools around real business problems.</p>
        <div class="actions"><a class="button primary" href="/work">Explore the work ↗</a><a class="button secondary" href="/contact">Start a project</a></div>
      </div>
      <aside class="hero-panel" aria-label="OmniAI Studio capabilities">
        <div class="panel-top"><span>OMNIAI / SYSTEM MAP</span><span class="status-dot">● ONLINE</span></div>
        <div class="system-flow"><div>INPUT</div><span>→</span><div>AI</div><span>→</span><div>WORKFLOW</div><span>→</span><div>OUTCOME</div></div>
        <p>Documents, leads, messages, forms, and business data can become structured actions instead of manual queues.</p>
      </aside>
    </section>

    <section class="section"><div class="kicker-grid">
      <div><strong>AI Automation</strong><span>Connect processes, APIs, data, and AI into useful workflows.</span></div>
      <div><strong>AI Agents</strong><span>Systems that can reason over information and execute defined tasks.</span></div>
      <div><strong>Document AI</strong><span>Extract and transform information from invoices, forms, and documents.</span></div>
      <div><strong>Custom Systems</strong><span>Focused tools built around a specific operational problem.</span></div>
    </div></section>

    <section class="section">
      <div class="section-head"><div><p class="eyebrow">SELECTED WORK</p><h2>Built, documented, and explained.</h2></div><a class="text-link" href="/work">View all work ↗</a></div>
      <div class="featured-card">
        <div class="featured-copy"><span class="tag">DOCUMENT AI · DEMONSTRATION</span><h3>AI Invoice Extractor</h3><p>A document-processing workflow concept for turning invoices into structured information, validating the result, and routing clean data into downstream automation.</p><div class="mini-tags"><span>OCR</span><span>LLM</span><span>Validation</span><span>Workflow Automation</span></div><a class="button secondary" href="/work/ai-invoice-extractor">View project ↗</a></div>
        <div class="featured-visual"><div class="doc-sheet"><div class="doc-line wide"></div><div class="doc-line"></div><div class="doc-grid"><i></i><i></i><i></i><i></i></div><div class="doc-line"></div><div class="doc-line short"></div></div><div class="scan-label">STRUCTURED OUTPUT</div></div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div><p class="eyebrow">CAPABILITIES</p><h2>From one bottleneck to an entire system.</h2></div><p>OmniAI Studio can combine automation, AI, APIs, data, validation, and human review instead of forcing every problem into the same template.</p></div>
      <div class="capability-grid">
        <a class="card capability" href="/services/ai-automation"><span class="number">01</span><h3>Business Automation</h3><p>Replace repetitive handoffs with reliable workflows across the tools a business already uses.</p><span class="arrow">↗</span></a>
        <a class="card capability" href="/services/document-ai"><span class="number">02</span><h3>Document Intelligence</h3><p>Turn invoices, forms, PDFs, and other messy documents into validated structured data.</p><span class="arrow">↗</span></a>
        <a class="card capability" href="/services/ai-agents"><span class="number">03</span><h3>AI Agents</h3><p>Design task-focused agents that can retrieve information, reason over it, and take defined actions.</p><span class="arrow">↗</span></a>
        <a class="card capability" href="/services/custom-ai-systems"><span class="number">04</span><h3>Custom AI Systems</h3><p>Build a focused internal tool, assistant, or integration around a specific operational requirement.</p><span class="arrow">↗</span></a>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div><p class="eyebrow">HOW WE BUILD</p><h2>Engineering before hype.</h2></div><p>Every project starts with the actual process. AI is one component of a system, not the entire system.</p></div>
      <div class="process-grid">
        <div><span>01</span><h3>Discover</h3><p>Map the bottleneck, inputs, decisions, systems, and edge cases.</p></div>
        <div><span>02</span><h3>Design</h3><p>Choose the workflow, model, integrations, validation, storage, and human checkpoints.</p></div>
        <div><span>03</span><h3>Build</h3><p>Turn the architecture into a working system and test it against realistic scenarios.</p></div>
        <div><span>04</span><h3>Improve</h3><p>Refine reliability, speed, cost, and maintainability using actual observations.</p></div>
      </div>
    </section>

    <section class="section evidence-section">
      <div><p class="eyebrow">A GROWING TECHNICAL LIBRARY</p><h2>See how the systems work.</h2><p class="lead">Future project pages will include architecture notes, workflow diagrams, sample videos, screenshots, technical decisions, and case-study evidence.</p></div>
      <div class="evidence-list"><div><span>01</span><strong>Workflow diagrams</strong><small>Understand the automation from input to output.</small></div><div><span>02</span><strong>Sample videos</strong><small>Watch the system handle a real demonstration.</small></div><div><span>03</span><strong>Case studies</strong><small>Read the problem, implementation, and verified outcome.</small></div></div>
    </section>

    <section class="section"><div class="card cta-card"><p class="eyebrow">HAVE A PROCESS WORTH AUTOMATING?</p><h2>Bring the messy workflow. We will turn it into a system.</h2><p>Tell OmniAI Studio what currently takes too much time, manual effort, or repetitive coordination.</p><a class="button primary" href="/contact">Talk to OmniAI Studio ↗</a></div></section>
  </div>
</BaseLayout>
<style>
.hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.55fr);gap:70px;align-items:end}.hero-panel{border:1px solid #202634;background:#0b0e15;border-radius:16px;padding:22px;align-self:end}.panel-top{display:flex;justify-content:space-between;font-size:9px;letter-spacing:.13em;color:#657085}.status-dot{color:#8de4f4}.system-flow{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin:55px 0 25px;font-size:10px;font-weight:800;letter-spacing:.08em}.system-flow div{border:1px solid #2b3546;border-radius:7px;padding:8px 9px;background:#101520}.system-flow span{color:#536075}.hero-panel p{font-size:13px;line-height:1.7;color:#778297}.text-link{font-size:13px;color:#8de4f4;text-decoration:none;white-space:nowrap}.featured-card{display:grid;grid-template-columns:1fr 1fr;min-height:430px;border:1px solid #202634;border-radius:18px;overflow:hidden;background:linear-gradient(120deg,#0c1019,#090c13)}.featured-copy{padding:42px;display:flex;flex-direction:column;align-items:flex-start}.featured-copy h3{font-size:clamp(34px,4vw,56px);letter-spacing:-.055em;margin:22px 0 12px}.featured-copy p{color:#8b95a8;line-height:1.7;max-width:560px;margin-bottom:22px}.mini-tags{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:auto}.mini-tags span{font-size:10px;color:#9ca6b7;border:1px solid #293343;border-radius:999px;padding:6px 8px}.featured-visual{position:relative;display:grid;place-items:center;background:radial-gradient(circle at 50% 45%,rgba(95,210,235,.08),transparent 42%);border-left:1px solid #202634}.doc-sheet{width:54%;aspect-ratio:.72;background:#eef2f4;border-radius:7px;padding:22px;box-shadow:0 25px 70px rgba(0,0,0,.45);transform:rotate(2deg)}.doc-line{height:7px;background:#c4ccd4;border-radius:5px;margin-bottom:12px}.doc-line.wide{width:82%}.doc-line.short{width:45%}.doc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin:24px 0}.doc-grid i{height:30px;background:#d8dee3;border-radius:4px}.scan-label{position:absolute;right:12%;bottom:14%;font-size:9px;letter-spacing:.14em;color:#8de4f4}.capability-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.capability{position:relative;min-height:240px}.capability .number{font-size:11px;color:#647086}.capability .arrow{position:absolute;right:26px;top:26px;color:#8de4f4}.capability h3{margin-top:55px}.process-grid{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid #202634;border-radius:16px;overflow:hidden}.process-grid>div{padding:28px;border-right:1px solid #202634;background:#0b0e15}.process-grid>div:last-child{border-right:0}.process-grid span,.evidence-list span{font-size:10px;color:#8de4f4;letter-spacing:.1em}.process-grid h3{font-size:20px;margin:55px 0 9px}.process-grid p{font-size:13px;line-height:1.6;color:#737e92}.evidence-section{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.evidence-section h2{font-size:42px;letter-spacing:-.05em;margin:18px 0}.evidence-list{border-top:1px solid #202634}.evidence-list div{display:grid;grid-template-columns:45px 1fr;gap:12px;padding:20px 0;border-bottom:1px solid #202634}.evidence-list strong{font-size:15px}.evidence-list small{grid-column:2;color:#737e92;font-size:12px}.cta-card{padding:55px!important}.cta-card h2{font-size:clamp(38px,5vw,64px);letter-spacing:-.055em;max-width:820px;margin:18px 0}.cta-card p:not(.eyebrow){color:#7e899c;max-width:650px;line-height:1.7;margin-bottom:28px}@media(max-width:900px){.hero-grid,.featured-card,.evidence-section{grid-template-columns:1fr}.hero-panel{max-width:600px}.featured-visual{min-height:350px;border-left:0;border-top:1px solid #202634}.process-grid{grid-template-columns:1fr 1fr}.process-grid>div:nth-child(2){border-right:0}.process-grid>div:nth-child(-n+2){border-bottom:1px solid #202634}}@media(max-width:600px){.hero-grid{gap:35px}.featured-copy{padding:28px}.featured-visual{min-height:280px}.capability-grid{grid-template-columns:1fr}.process-grid{grid-template-columns:1fr}.process-grid>div{border-right:0!important;border-bottom:1px solid #202634}.process-grid>div:last-child{border-bottom:0}.evidence-section{gap:40px}}
</style>
