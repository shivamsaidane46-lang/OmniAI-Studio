---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'OmniAI Studio — AI Automation & Intelligent Systems';
const description = 'OmniAI Studio builds AI-powered automations, intelligent workflows, document processing systems, AI agents, and custom business tools.';
---
<BaseLayout title={title} description={description} canonical="https://omniaistudio.in/">
  <div class="page">
    <section>
      <p class="eyebrow">AI AUTOMATION & INTELLIGENT SYSTEMS</p>
      <h1 class="display">We build intelligent systems for work that should not be manual.</h1>
      <p class="lead">OmniAI Studio designs and builds AI-powered workflows, automations, agents, document-processing systems, integrations, and custom tools around real business problems.</p>
      <div class="actions"><a class="button primary" href="/work">Explore the work ↗</a><a class="button secondary" href="/contact">Start a project</a></div>
    </section>

    <section class="section"><div class="kicker-grid">
      <div><strong>AI Automation</strong><span>Connect processes, APIs, data, and AI into useful workflows.</span></div>
      <div><strong>AI Agents</strong><span>Systems that can reason over information and execute defined tasks.</span></div>
      <div><strong>Document AI</strong><span>Extract and transform information from invoices, forms, and documents.</span></div>
      <div><strong>Custom Systems</strong><span>Focused tools built around a specific operational problem.</span></div>
    </div></section>

    <section class="section">
      <div class="section-head"><h2>Selected work</h2><p>Every project will have its own page with the problem, approach, workflow, technologies, demo, and case-study evidence.</p></div>
      <div class="grid">
        <a class="card" href="/work/ai-invoice-extractor"><span class="tag">Document AI · Portfolio</span><h3>AI Invoice Extractor</h3><p>A workflow concept for turning invoice documents into structured information and downstream automation.</p></a>
        <a class="card" href="/work"><span class="tag">More projects coming</span><h3>Build log</h3><p>The portfolio will grow as OmniAI Studio builds and documents new automation systems.</p></a>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>Built for useful outcomes</h2><p>No invented results. Projects and case studies will clearly separate demonstrations, prototypes, and verified client outcomes.</p></div>
      <div class="grid">
        <div class="card"><span class="tag">01 · Discover</span><h3>Understand the bottleneck</h3><p>Map the process, inputs, decisions, systems, and repetitive work before choosing an automation.</p></div>
        <div class="card"><span class="tag">02 · Design</span><h3>Design the system</h3><p>Choose the right combination of workflows, AI, APIs, validation, storage, and human review.</p></div>
        <div class="card"><span class="tag">03 · Build</span><h3>Build and test</h3><p>Turn the design into a working system and test edge cases before treating it as production-ready.</p></div>
        <div class="card"><span class="tag">04 · Improve</span><h3>Measure and refine</h3><p>Use real observations and feedback to improve reliability, speed, and maintainability.</p></div>
      </div>
    </section>

    <section class="section"><div class="card" style="padding:48px"><p class="eyebrow">HAVE A PROCESS WORTH AUTOMATING?</p><h2 style="font-size:clamp(34px,5vw,58px);letter-spacing:-.05em;max-width:760px;margin:18px 0">Bring the messy workflow. We will turn it into a system.</h2><a class="button primary" href="/contact">Talk to OmniAI Studio ↗</a></div></section>
  </div>
</BaseLayout>
