---
const title = 'OmniAI Studio — AI Automation & Intelligent Systems';
const description = 'OmniAI Studio builds AI-powered automations, intelligent workflows, document processing systems, AI agents, and custom business tools.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://omniaistudio.in/" />
  </head>
  <body>
    <header>
      <a href="/" aria-label="OmniAI Studio home">OmniAI Studio</a>
      <nav>
        <a href="/work">Work</a>
        <a href="/case-studies">Case Studies</a>
        <a href="/services">Services</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">AI AUTOMATION & INTELLIGENT SYSTEMS</p>
        <h1>Turn repetitive business work into intelligent systems.</h1>
        <p class="lead">OmniAI Studio designs and builds AI-powered workflows, automations, agents, document processing systems, and custom tools for real business problems.</p>
        <div class="actions">
          <a class="primary" href="/work">Explore the work</a>
          <a class="secondary" href="/contact">Start a project</a>
        </div>
      </section>

      <section class="grid">
        <article><h2>AI Automation</h2><p>Connect business processes, APIs, data, and AI into reliable automated workflows.</p></article>
        <article><h2>AI Agents</h2><p>Build systems that can reason over information and execute useful business tasks.</p></article>
        <article><h2>Document Intelligence</h2><p>Extract, classify, transform, and route information from invoices, forms, and documents.</p></article>
        <article><h2>Custom AI Tools</h2><p>Turn a specific operational problem into a focused internal tool or client-facing system.</p></article>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} OmniAI Studio. AI automation and intelligent systems.</p>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #070a12; color: #f5f7fb; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  header { max-width: 1180px; margin: auto; padding: 28px 24px; display: flex; justify-content: space-between; align-items: center; gap: 30px; }
  header > a { color: white; text-decoration: none; font-weight: 800; font-size: 20px; }
  nav { display: flex; gap: 24px; flex-wrap: wrap; }
  nav a { color: #aeb6c8; text-decoration: none; font-size: 14px; }
  nav a:hover { color: white; }
  main { max-width: 1180px; margin: auto; padding: 70px 24px 100px; }
  .hero { max-width: 850px; padding: 70px 0 90px; }
  .eyebrow { color: #79d8ef; letter-spacing: .16em; font-size: 12px; font-weight: 800; }
  h1 { font-size: clamp(46px, 8vw, 86px); line-height: .98; letter-spacing: -.05em; margin: 22px 0; }
  .lead { color: #aeb6c8; font-size: 20px; line-height: 1.65; max-width: 720px; }
  .actions { display: flex; gap: 14px; margin-top: 34px; flex-wrap: wrap; }
  .actions a { padding: 14px 20px; border-radius: 10px; text-decoration: none; font-weight: 700; }
  .primary { background: #f5f7fb; color: #070a12; }
  .secondary { border: 1px solid #30384a; color: #f5f7fb; }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  article { border: 1px solid #202738; background: #0b0f19; padding: 24px; border-radius: 14px; }
  article h2 { font-size: 18px; }
  article p { color: #8993a8; line-height: 1.6; font-size: 14px; }
  footer { max-width: 1180px; margin: auto; padding: 30px 24px 50px; border-top: 1px solid #202738; color: #6f788b; font-size: 13px; }
  @media (max-width: 800px) { header { align-items: flex-start; flex-direction: column; } .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
</style>
